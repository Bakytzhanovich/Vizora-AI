# Copy to frontend/.env.local and fill in real values.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth ("Sign in with Google"). Client ID from Google Cloud Console —
# same value the backend uses as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web Push (browser notifications). Must match the backend's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty outside
# production — the tag is skipped entirely when unset, which keeps local and
# preview traffic out of the production property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
  