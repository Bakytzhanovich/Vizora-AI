# Copy to backend/.env and fill in production values.
# Never commit real secrets.

# Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://vizora:secure_password@localhost:5432/vizora

# Railway may provide postgresql://...; the app normalizes it to postgresql+asyncpg://...
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local SQLite fallback for quick development only:
# DATABASE_URL=sqlite+aiosqlite:///./vizora.db

# In production, run Alembic migrations before starting the app and keep this false.
# Keep true locally if you want SQLAlchemy to create missing dev tables automatically.
AUTO_CREATE_TABLES=false

# Runs `alembic upgrade head` on every startup. Needed on platforms without
# shell/job access (e.g. Render free tier). Set to false if you run migrations
# manually as a separate deploy step.
RUN_MIGRATIONS_ON_STARTUP=true

ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

TELEGRAM_BOT_TOKEN=
NOTIFICATION_SECRET=
ADMIN_SECRET=

# Google OAuth ("Sign in with Google"). Client ID from Google Cloud Console —
# same value the frontend uses as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web Push (browser notifications). Generate with:
#   python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); ..."
# Public key must match the frontend's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@vizora.ai

# Optional one-time admin bootstrap for production platforms without shell access.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the admin account is created if you want.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Kaspi Pay (subscriptions). No self-serve API exists — see
# app/services/kaspi_pay_client.py for what's real vs. placeholder here.
# Leave KASPI_API_KEY empty to run in mock mode (simulated payments, no real
# Kaspi calls) — safe for local dev and demos.
KASPI_MOCK_MODE=true
KASPI_API_KEY=
KASPI_MERCHANT_ID=
KASPI_API_BASE_URL=https://api.kaspi.kz/pay/v1
KASPI_WEBHOOK_SECRET=
