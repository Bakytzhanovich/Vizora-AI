# Copy to backend/.env and fill in production values.
# Never commit real secrets.

# Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://vizora:secure_password@localhost:5432/vizora

# Railway may provide postgresql://...; the app normalizes it to postgresql+asyncpg://...
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local SQLite fallback for quick development only:
# DATABASE_URL=sqlite+aiosqlite:///./vizora.db

# In production, run Alembic migrations before starting the app and keep this false.
# Keep true locally if you want SQLAlchemy to create missing dev tables automatically.
AUTO_CREATE_TABLES=false

ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

TELEGRAM_BOT_TOKEN=
NOTIFICATION_SECRET=
ADMIN_SECRET=

# Google OAuth ("Sign in with Google"). Client ID from Google Cloud Console —
# same value the frontend uses as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional one-time admin bootstrap for production platforms without shell access.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the admin account is created if you want.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
